# Server-side secrets
# These variables must NOT use the VITE_ prefix because they are kept on the Express server.
WEATHER_API_KEY=
NEWS_API_KEY=
GNEWS_API_KEY=

# Optional Express port for local development
PORT=5000

# Client-side Firebase configuration
# Firebase web configuration is intentionally exposed to the browser by Vite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
